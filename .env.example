# Umami analytics (optional). Leave unset and the script tag in layout.tsx
# simply doesn't render - no build error, no blank analytics call.
#
# Get these from your Umami dashboard (self-hosted or umami.is cloud) after
# creating a website there. For GitHub Pages, set them as repo variables under
# Settings > Secrets and variables > Actions > Variables. For Vercel, set them
# as a project Environment Variable.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Public stats link (optional). Makes the nav bar's visitor count clickable,
# opening your site's Umami dashboard. Requires enabling "Share URL" for this
# website in Umami settings first - that's what makes the dashboard safe to
# link publicly (read-only, no login, no API key exposed). Leave unset and
# the count still shows, just isn't a link.
NEXT_PUBLIC_UMAMI_SHARE_URL=

# Server-only secret, NEVER prefix this with NEXT_PUBLIC_. Powers the live
# visitor count in the nav bar via src/app/api/visitor-count/route.ts, which
# only runs on Vercel - GitHub Pages has no server, so this only ever needs
# to be set in Vercel's project env vars (as Sensitive/Encrypted), never as
# a GitHub Actions variable. From Umami: Settings > API keys > Create key.
UMAMI_API_KEY=
