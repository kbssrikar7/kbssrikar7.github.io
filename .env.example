# Umami analytics (optional). Leave unset and the script tag in layout.tsx
# simply doesn't render - no build error, no blank analytics call.
#
# Get these from your Umami dashboard (self-hosted or umami.is cloud) after
# creating a website there. For GitHub Pages, set them as repo variables under
# Settings > Secrets and variables > Actions > Variables. For Vercel, set them
# as a project Environment Variable.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Public stats link (optional). Renders an eye icon in the nav bar linking to
# your site's Umami dashboard. Requires enabling "Share URL" for this website
# in Umami settings first - that's what makes the dashboard safe to link
# publicly (read-only, no login, no API key exposed). Leave unset and the
# icon simply doesn't render.
NEXT_PUBLIC_UMAMI_SHARE_URL=
